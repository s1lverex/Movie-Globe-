# ─────────────────────────────────────────────────────────────────────────────
# Travel Globe — environment configuration
#
# Everything works with these left EMPTY: the app uses only free services
# (OpenStreetMap Nominatim for place search, plain Trip.com links).
# Fill in keys here later to switch on paid providers.
#
# ⚠️  This file is committed so the slots are visible. Do NOT put real secrets
#     in it. Put real values in `.env.local` (same variable names) — that file
#     is git-ignored and overrides this one (Vite loads .env, then .env.local).
#
# ⚠️  Anything starting with VITE_ is bundled into the browser JavaScript and is
#     PUBLIC. Only use VITE_ for keys that are meant to be public / restricted by
#     domain (e.g. a referrer-locked maps key). Secret keys belong in the
#     "server-only" section and need a backend/serverless proxy to use them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Geolocation / place search (browser) ─────────────────────────────────────
# Provider used for "search any place" and naming tapped pins in Normal Mode.
#   nominatim (default, free)   → OpenStreetMap Nominatim, no key needed
#   locationiq                  → LocationIQ (Nominatim-compatible, paid tiers)
#   custom                      → any Nominatim-compatible endpoint (set URL)
VITE_GEOCODER_PROVIDER=nominatim
# Override the base URL (optional). Defaults: nominatim → https://nominatim.openstreetmap.org
#                                             locationiq → https://us1.locationiq.com/v1
VITE_GEOCODER_URL=
# API key for locationiq / custom (sent as ?key=). Leave empty for nominatim.
VITE_GEOCODER_KEY=

# Reserved for future map / geocoding providers (not wired up yet).
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=
VITE_OPENCAGE_API_KEY=

# ── Travel booking (browser) ─────────────────────────────────────────────────
# Trip.com affiliate params appended to every outbound link (free programme),
# e.g. "Allianceid=123456&SID=7890123".
VITE_TRIP_AFFILIATE_PARAMS=
# Reserved for future partner links (not wired up yet).
VITE_BOOKING_AFFILIATE_ID=
VITE_EXPEDIA_AFFILIATE_ID=
VITE_SKYSCANNER_ASSOCIATE_ID=

# ── Server-only secrets (NOT exposed to the browser; need a backend) ─────────
# Reserved for future paid travel / geolocation APIs called from a server or
# serverless function. The current static app does not read these.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
SKYSCANNER_API_KEY=
KIWI_TEQUILA_API_KEY=
BOOKING_API_KEY=
EXPEDIA_API_KEY=
EXPEDIA_API_SECRET=
GOOGLE_PLACES_API_KEY=
AI_API_KEY=
